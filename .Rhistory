#| label: data_plot2
refined_rgap_df <- bind_rows(
mutate(data$bm_refined_rgap, algorithm = "BM"),
mutate(data$dua_refined_rgap, algorithm = "duaIterate")
) |>
mutate(congestion_regime = make_congestion_regime(n_agents))
refined_rgap_summary <- refined_rgap_df |>
group_by(algorithm, congestion_regime, episode, time_interval) |>
summarise(
mean_refined_rgap = mean(refined_rgap),
.groups = "drop"
)
# I filter duaIterate algorithm, because I only computed its refined r-gap for
# the last episode, not for all the episodes
refined_rgap_summary <- refined_rgap_summary |>
filter(
algorithm != "duaIterate"
)
#| label: plot2
ggplot(
data = refined_rgap_summary,
mapping = aes(x = episode, y = time_interval, fill = mean_refined_rgap)
) +
geom_tile() +
scale_fill_viridis_c() +
facet_grid(algorithm ~ congestion_regime) +
labs(
title = "Refined R-gap by departure interval across episodes",
subtitle = "Mean across seeds",
x = "Episode",
y = "Departure interval",
fill = "Mean refined\nR-gap (%)"
)
ggsave(here("r","RQ1","figures","plot2_refined_rgap_heatmap.png"))
#| label: plot2
ggplot(
data = refined_rgap_df,
mapping = aes(x = episode, y = time_interval, fill = refined_rgap)
) +
geom_tile() +
scale_fill_viridis_c(
limits = c(0, 50),
oob = scales::squish
) +
facet_grid(seed_fct ~ congestion_regime, scales = "free_x", space = "free_x") +
labs(
title = "Refined R-gap by departure interval across episodes",
subtitle = "Per-seed trajectories for three random seeds (BM)",
x = "Episode",
y = "Departure interval",
fill = "Refined\nR-gap (%)"
)
