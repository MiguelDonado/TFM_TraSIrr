@article{DTD_wei,
	title = {A {Day} to {Day} {Route} {Choice} {Model} {Based} on {Reinforcement} {Learning}},
	volume = {2014},
	issn = {1024-123X, 1563-5147},
	url = {https://onlinelibrary.wiley.com/doi/10.1155/2014/646548},
	doi = {10.1155/2014/646548},
	abstract = {Day‐to‐day traffic dynamics are generated by individual traveler’s route choice and route adjustment behaviors, which are appropriate to be researched by using agent‐based model and learning theory. In this paper, we propose a day‐to‐day route choice model based on reinforcement learning and multiagent simulation. Travelers’ memory, learning rate, and experience cognition are taken into account. Then the model is verified and analyzed. Results show that the network flow can converge to user equilibrium (UE) if travelers can remember all the travel time they have experienced, but which is not necessarily the case under limited memory; learning rate can strengthen the flow fluctuation, but memory leads to the contrary side; moreover, high learning rate results in the cyclical oscillation during the process of flow evolution. Finally, both the scenarios of link capacity degradation and random link capacity are used to illustrate the model’s applications. Analyses and applications of our model demonstrate the model is reasonable and useful for studying the day‐to‐day traffic dynamics.},
	language = {en},
	number = {1},
	urldate = {2026-02-17},
	journal = {Mathematical Problems in Engineering},
	author = {Wei, Fangfang and Ma, Shoufeng and Jia, Ning},
	editor = {Zhang, X.},
	month = jan,
	year = {2014},
	pages = {646548},
	file = {2014_Day-to-Day-Route-Choice-Model-Based-on-RL_Hindawi_RL:/home/miguel/Zotero/storage/G468IL3N/2014_Day-to-Day-Route-Choice-Model-Based-on-RL_Hindawi_RL.pdf:application/pdf;Full Text PDF:/home/miguel/Zotero/storage/IZ2W2MDR/Wei et al. - 2014 - A Day to Day Route Choice Model Based on Reinforcement Learning.pdf:application/pdf},
}

