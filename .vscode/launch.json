// “How should I run/debug my code?”

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
    },
    {
      "name": "Debug network_stats.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/network_stats.py",
      "console": "integratedTerminal",
      "justMyCode": true,
    },
    {
      "name": "Debug demand_calibration.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/demand_calibration.py",
      "console": "integratedTerminal",
      "justMyCode": true,
    },
  ]
}